# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/digital-menu?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRE=30d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
# Choose one provider: 'resend', 'brevo', or 'nodemailer'
EMAIL_PROVIDER=resend

# Email From Address (used by all providers)
EMAIL_FROM=noreply@yourdomain.com

# --------------------------------------------
# OPTION 1: Resend (Recommended - Modern & Easy)
# --------------------------------------------
# Sign up at: https://resend.com
# Free tier: 100 emails/day, 3,000 emails/month
# Pricing: $20/month for 50,000 emails
RESEND_API_KEY=re_your_api_key_here

# --------------------------------------------
# OPTION 2: Brevo (Sendinblue) (Good for High Volume)
# --------------------------------------------
# Sign up at: https://www.brevo.com
# Free tier: 300 emails/day
# Pricing: $25/month for 20,000 emails
BREVO_API_KEY=your_brevo_api_key_here

# --------------------------------------------
# OPTION 3: Nodemailer with SMTP (Traditional)
# --------------------------------------------
# Works with Gmail, Outlook, custom SMTP servers

# For Gmail:
# 1. Enable 2FA in your Google Account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# For Mailtrap (Testing Only):
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER=your-mailtrap-username
# EMAIL_PASSWORD=your-mailtrap-password

# For Custom SMTP:
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=noreply@yourdomain.com
# EMAIL_PASSWORD=your-smtp-password
